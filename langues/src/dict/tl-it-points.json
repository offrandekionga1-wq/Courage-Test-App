i sono quattro stagioni.","","apat"],["May limang lapis dito.","Ci sono cinque matite qui.","","limang"],["May tatlo siyang ate.","Ha tre sorelle maggiori.","","tatlo"],["May sampu kaming baka.","Abbiamo dieci pezzi di bestiame.","","sampu"],["\"Ilang taon ka na?\" \"Labing-anim.\"","\"Quanti anni hai?\" \"Sedici.\"","","anim"]]},"pang-uri":{"o":["kaysa","mas","sobrang","pinakamalapit","napakagalang","pinakamahirap","napakahaba","pinakamagaling"],"s":[["Mas maganda ako kaysa sa iyo.","Sono più bella di te.","","kaysa"],["Mukha kang mas bata.","Sembri più giovane.","","mas"],["Bakit ang sobrang init?","Perché fa così caldo?","","sobrang"],["Saan ang pinakamalapit na museo?","Dov'è il museo più vicino?","","pinakamalapit"],["Napakabait at napakagalang ng nars na iyan.","Quell'infermiere è molto gentile ed educato.","","napakagalang"],["Sa lahat ng mga wikang inaral ko, ang Pranses ang pinakamahirap.","Di tutte le lingue che ho studiato, il francese era la più difficile.","","pinakamahirap"],["Madalas pagtawanan ang aktres na iyon dahil sa napakahaba niyang baba.","Quell'attrice è spesso canzonata per via del suo mento molto lungo.","","napakahaba"],["Ang gútom ang pinakamagaling na salsa.","La fame è il miglior condimento.","","pinakamagaling"],["Saan ba ang pinakamagandang lugar sa mundo?","Dov'è il posto più bello del mondo?","","pinakamagandang"],["Puwede bang hawakan ang pinakailalim?","Riesci a toccare il fondo?","","pinakailalim"]]},"pag-aari":{"o":["akin","may","iyo","kanya","wala","mayroon","kanino","meron"],"s":[["Alin ang akin?","Qual è il mio?","","akin"],["Sinong may alam?","Chi lo sa?","","may"],["Sa iyo ba ito?","Questo è tuo?","","iyo"],["Sa kanya iyan.","È suo.","","kanya"],["Sino ang wala?","Chi è assente?","","wala"],["Anong mayroon?","Come va?","","mayroon"],["Para kanino ito?","Per chi è questo?","","kanino"],["Sana meron din ako.","Vorrei averne uno.","","meron"],["Ipakita sa akin.","Fammi vedere.","","akin"],["Sinong may oras?","Chi ha tempo?","","may"]]},"gusto":{"o":["gusto","ayaw","kailangan","puwede","dapat"],"s":[["Anong gusto mo?","Che vuoi?","","gusto"],["Sino dapat una?","Chi dovrebbe partire?","","dapat"],["Ano ang kailangan mo?","Cosa ti serve?","","kailangan"],["Hindi, ayaw ko.","No, non voglio.","","ayaw"],["Hindi ako puwede.","Non posso.","","puwede"],["Ito ang gusto ko.","Questo è quello che volevo.","","gusto"],["Nagdiriwang po dapat tayo.","Dovremmo festeggiare.","","dapat"],["Sino ang may kailangan?","Chi ne ha bisogno?","","kailangan"],["Salamat, ayaw ko nito.","Grazie, lo odio.","","ayaw"],["Oo, puwede tayong magpalit.","Sì, possiamo cambiare.","","puwede"]]},"maka":{"o":["nakita","makatulog","makakain","narinig","nalaman","makapunta"],"s":[["Di ko siya nakita.","Non l'ho vista.","","nakita"],["Hindi ako makatulog.","Non riesco a dormire.","","makatulog"],["Hindi ako makakain.","Non posso mangiare.","","makakain"],["May narinig kaming barilan.","Abbiamo sentito sparare.","","narinig"],["Hindi ko nalaman kung sino sila.","Non sapevo chi fossero.","","nalaman"],["Sana makapunta ako sa Hapon.","Mi piacerebbe tanto andare in Giappone.","","makapunta"],["Sana'y nakita mo ang sine.","Avresti dovuto vedere il film.","","nakita"],["Di kami makatulog dahil sa ingay.","Non riusciamo a dormire dal rumore.","","makatulog"],["Tara at maghanap tayo ng makakain.","Usciamo a prendere qualcosa da mangiare.","","makakain"],["May narinig tayong barilan.","Abbiamo sentito sparare.","","narinig"]]}}}