{"v":1,"p":{"ordre":{"o":["ang","ng","sa","si","ni","kay"],"s":[["Itim ang pusa.","猫は黒いんだ。","","ang"],["Pumili ng isa.","一つ選んで。","","ng"],["Pasok sa kotse.","車に乗って。","","sa"],["Nawala si Tom.","トムは行方不明になった。","","si"],["Naalala ni Tom.","トムは思い出した。","","ni"],["Itanong mo kay Alex.","アレックスに聞いてみなさい。","","kay"],["Puno ang tren.","その電車は混んでいた。","","ang"],["Ano'ng balita?","どんなニュースなの？","","ng"],["Ayaw ko sa iyo.","あなたのことが大嫌い。","","sa"],["Tumayo si Tom.","トムは立った。","","si"]]},"pronoms":{"o":["ako","ikaw","siya","kami","tayo","sila"],"s":[["Nagkamali ako.","私が間違っていました。","","ako"],["Tumataba siya.","彼は体重が増えている。","","siya"],["Nag-usap kami.","僕らは話した。","","kami"],["Umuwi na tayo!","帰ろう。","","tayo"],["Nakawala sila.","彼らは逃げた。","","sila"],["Hindi ba ikaw Tom?","トムなのか？","","ikaw"],["Buntis ba ako?","私が妊娠した？","","ako"],["Tulog ba siya?","寝てるの？","","siya"],["Sumusuko kami.","降参します。","","kami"],["Magrebyu tayo.","見直しをしようじゃないか。","","tayo"]]},"demonstratifs":{"o":["ito","iyan","iyon","dito","diyan","doon"],"s":[["Sa iyo ba ito?","これ、あなたのですか？","","ito"],["Delikado iyon!","危なかった！","","iyon"],["Libro ko iyan.","あれは私の本です。","","iyan"],["Lingon ka dito.","顔をこちらへ向けなさい。","","dito"],["Pupunta ako doon.","すぐ参ります。","","doon"],["Lumiko ka diyan.","そこを右に曲がって。","","diyan"],["Ayusin mo ito.","これ直して。","","ito"],["Nakita mo iyon?","あなたはそれを見ましたか？","","iyon"],["Puwede na iyan.","それだけで十分足りるだろう。","","iyan"],["Wala siya dito.","彼女はここにはいない。","","dito"]]},"negation-questions":{"o":["Ano","Sino","Saan","Kailan","Paano","Bakit"],"s":[["Ano'ng balita?","どんなニュースなの？","","Ano"],["Bakit ka galit?","なぜ怒っているのですか。","","Bakit"],["Sino ang wala?","休んでいるのは誰ですか。","","Sino"],["Saan ang Paris?","パリはどこにありますか。","","Saan"],["Kailan ka aalis?","君はいつ帰る？","","Kailan"],["Paano ko malalaman?","俺は知らないよ。","","Paano"],["Ano'ng oras na?","何時ですか。","","Ano"],["Bakit ka nahuli?","なぜ遅刻したのですか。","","Bakit"],["Sino ang nagsira?","これを壊したのはだれですか。","","Sino"],["Saan ka pupunta?","どこに行きますか？","","Saan"]]},"aspects":{"o":["pumunta","kumain","pupunta",