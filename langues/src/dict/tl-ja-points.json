ng sobrang init?","なんでこんなに暑いんだよ。","","sobrang"],["Saan ang pinakamalapit na museo?","一番近い博物館はどこにありますか。","","pinakamalapit"],["Tumalon ka nang pinakamataas na kaya mo.","できるだけ高く跳びなさい。","","pinakamataas"],["Napakabait at napakagalang ng nars na iyan.","あの看護婦さんはとてもやさしくて礼儀正しいです。","","napakagalang"],["Ang elepante ay ang pinakamalaking hayop sa lupa.","象は陸上の動物の中で最も大きい。","","pinakamalaking"],["Binigyang-diin niya ang mga pinakakombinyenteng aspekto ng buhay sa siyudad.","彼は都会生活の便利な面を強調した。","","pinakakombinyenteng"],["Ako ang pinakamagaling.","私は最高だ。","","pinakamagaling"]]},"pag-aari":{"o":["akin","may","iyo","kanya","wala","mayroon","meron"],"s":[["Alin ang akin?","どちらが私のものですか。","","akin"],["Sinong may alam?","誰にも分からないよ。","","may"],["Sa iyo ba ito?","これ、あなたのですか？","","iyo"],["Galit ako sa kanya.","僕は彼女に腹を立てている。","","kanya"],["Sino ang wala?","休んでいるのは誰ですか。","","wala"],["Anong mayroon?","何が起こったんだ？","","mayroon"],["Parang meron na tayo ng lahat.","全部そろっているようです。","","meron"],["Ipakita sa akin.","見せて。","","akin"],["Walang may alam.","誰も知らなかった。","","may"],["Ayaw ko sa iyo.","あなたのことが大嫌い。","","iyo"]]},"gusto":{"o":["gusto","ayaw","kailangan","puwede","dapat"],"s":[["Anong gusto mo?","あなたは何を求めているのですか。","","gusto"],["Anong dapat kong dalhin?","何を持って行けばいいですか。","","dapat"],["Alam mong ayaw ko ng itlog.","俺が卵嫌いってこと分かってるだろ。","","ayaw"],["Ano ang kailangan mo?","何が必要ですか。","","kailangan"],["Hindi kita gusto.","君のこと好きじゃないんだ。","","gusto"],["Baka dapat maghintay ka.","たぶん待った方がいいよね。","","dapat"],["Ayaw na ayaw ko talaga sa mga ahas.","蛇が、大、大、大っ嫌いなの。","","ayaw"],["Magkano ang kailangan mo?","いくら欲しいの？","","kailangan"],["Alin ang gusto mo?","どちらになさいますか？","","gusto"],["Sori, dapat umalis na ako.","ごめん帰らなきゃ。","","dapat"]]},"maka":{"o":["nakita","makatulog","narinig","makapunta","nalaman","makakain","nasira","nakapagdesisyon"],"s":[["Sinong nakita mo?","誰に会ったの？","","nakita"],["Hindi ako makatulog.","眠れないんですよ。","","makatulog"],["May narinig akong tumutuktok.","誰かがノックする音がした。","","narinig"],["Baka mak