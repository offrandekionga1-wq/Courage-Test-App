potrebbe"],["Non dovresti nuotare in quello stagno.","Tau nereikėtų plaukioti tame tvenkinyje.","","dovresti"],["Se fossi al tuo posto, farei altrettanto.","Tavo vietoje būčiau padaręs tą patį.","","farei"],["Voi speravate che non vi avrei deluso, ma, ahimè, non sono riuscito a fare niente.","Tikėjotės, kad aš jūsų nenuvilsiu, bet, deja, nesugebėjau nieko padaryti.","","avrei"],["Secondo me sarebbe difficile risolvere questo problema.","Mano nuomone, bus sunku išspręsti šią problemą.","","sarebbe"]]},"imperatif":{"o":["vieni","prendi","dimmi","stai","aspetta","ascolta","fammi","guarda"],"s":[["Vieni domattina.","Ateik rytoj ryte.","","Vieni"],["Prendi entrambi.","Imkite abu.","","Prendi"],["Dimmi il tuo nome.","Pasakyk man savo vardą.","","Dimmi"],["Stai tranquillo.","Nusiramink.","","Stai"],["Aspetta un attimo.","Palauk minutėlę.","","Aspetta"],["Ascolta attentamente.","Klausykis atidžiai.","","Ascolta"],["Fammi andare al negozio.","Leisk man eiti į pardotuvę.","","Fammi"],["Guarda la casa con il tetto rosso.","Pažiūrėk į tą namą su raudonu stogu.","","Guarda"],["Vieni dopodomani.","Ateik poryt.","","Vieni"],["Prendi la tua roba.","Griebk savo daiktus.","","Prendi"]]},"comparaison-relatifs":{"o":["più","meno","meglio","peggio","migliore"],"s":[["Ora o mai più.","Dabar arba niekada.","","più"],["È il mio migliore amico.","Jis mano geriausias draugas.","","migliore"],["Va meglio ora?","Ar dabar jautiesi geriau?","","meglio"],["Il meno è il più.","Mažiau yra daugiau.","","meno"],["Tu non mi piaci più.","Tu man nebepatinki.","","più"],["Lui è il mio migliore amico.","Jis mano geriausias draugas.","","migliore"],["Io posso fare di meglio.","Aš galiu padaryti geriau.","","meglio"],["Ha non meno di sette figli.","Ji turi ne mažiau kaip septynis vaikus.","","meno"],["Devi lavorare di più.","Tu turi daugiau dirbti.","","più"],["Io sono di umore migliore ora.","Dabar aš jaučiuosi geriau.","","migliore"]]},"congiuntivo":{"o":["sia","abbia"],"s":[["Io penso che sia tu.","Manau, kad tai esi tu.","","sia"],["Alcune persone pensano che io abbia una volontà debole.","Kai kurie mano kad aš silpnavalis.","","abbia"],["Io penso che sia lei.","Manau, kad tai esi tu.","","sia"],["Voglio che tu sia qui.","Noriu kad būtum čia.","","sia"],["Voglio che lei sia qui.","Noriu kad būtum čia.","","sia"],["Pensi che io sia stupido?","Manai kad esu kvailas?","","sia"],["Pensa che io sia stupido?","Manai kad esu kvailas?","","sia"],["Pensate che io sia stupido?","Manai kad esu kvailas?","","sia"],["Sono convinto che sia innocente.","Aš esu įsitikinusi kad jis yra nekaltas.","","sia"],["Spero che ci sia il Sole domani.","Tikiuosi, rytoj bus saulėta.","","sia"]]},"ipotetico":{"o":["fossi","sapessi"],"s":[["Se fossi al tuo posto, farei altrettanto.","Tavo vietoje būčiau padaręs tą patį.","","fossi"],["Se sapessi la verità gliela direi.","Jei aš žinočiau tiesą, aš tau ją pasakyčiau.","","sapessi"],["Ah! Se fossi ricco, mi comprerei una casa in Spagna.","Ak! Jei aš būčiau turtinga, aš sau nusipirkčiau namą Ispanijoje.","","fossi"]]},"passato-remoto":{"o":["fu","andò","disse","vide","fece","venne"],"s":[["Nessuno fu ferito.","Niekas nebuvo sužeistas.","","fu"],["Tom andò al museo con Mary.","Tomas su Merė nuėjo į muziejų.","","andò"],["Gli disse che era felice.","Ji jam pasakė kad ji buvo laiminga.","","disse"],["Alice non vide il cane.","Alisa nematė to šuns.","","vide"],["Mary fece irruzione nella cucina.","Merė įsiveržė į virtuvę.","","fece"],["Nessuno venne alla festa eccetto John e Dick.","Niekas neatėjo į vakarėlį, išskyrus Džoną ir Diką.","","venne"],["Il viaggio fu spossante.","Kelionė buvo varginanti.","","fu"],["Se ne andò senza neppure dire una parola.","Ji išėjo nepasakiusi nė žodžio.","","andò"],["Lei gli disse che era felice.","Ji jam pasakė kad ji buvo laiminga.","","disse"],["Lei vide il mio nome scritto sulla parete.","Ji pamatė mano vardą užrašytą ant sienos.","","vide"]]}}}