i.","","può"],["Che devo fare?","Ką man reikia daryti?","","devo"],["Tom vuole imparare.","Tomas nori mokytis.","","vuole"],["Fai come vuoi.","Daryk, kaip nori.","","vuoi"],["In quel caso, andiamo.","Tokiu atveju, einame.","","andiamo"],["Come puoi dirlo?","Kaip gali kažką tokio pasakyti?","","puoi"],["Lei deve amarti.","Tikriausiai ji myli tave.","","deve"]]},"adjectifs":{"o":["mio","mia","tuo","tua","suo","sua"],"s":[["Sei mio padre.","Jūs esate mano tėvas.","","mio"],["Sono suo amico?","Ar aš esu tavo draugas?","","suo"],["Amo mia mamma.","Aš myliu savo mamą.","","mia"],["È sua sorella?","Ar ji tavo sesuo?","","sua"],["Sono tuo amico?","Ar aš esu tavo draugas?","","tuo"],["Ami tua madre?","Ar tu myli savo motiną?","","tua"],["È il mio cane.","Tai mano šuo.","","mio"],["È il suo ragazzo.","Tai jos vaikinas.","","suo"],["Sei mia amica?","Ar tu esi mano draugas?","","mia"],["Amo sua figlia.","Aš myliu jūsų dukrą.","","sua"]]},"prepositions":{"o":["al","alla","del","della","nel","nella","dal","sul"],"s":[["Sono al verde.","Aš neturiu pinigų.","","al"],["Ho male alla testa.","Man skauda galvą.","","alla"],["Bevete del tè.","Tu geri arbatą.","","del"],["Mi serve della farina.","Man reikia miltų.","","della"],["Tom è sul tetto.","Tomas yra ant stogo.","","sul"],["Ci perdemmo nella nebbia.","Mes rūke pasiklydome.","","nella"],["Vive nel villaggio.","Ji gyvena kaime.","","nel"],["Vai dal barbiere.","Nueik į kirpyklą.","","dal"],["In bocca al lupo!","Sekmės!","","al"],["Sono alla spiaggia.","Jie yra paplūdimyje.","","alla"]]},"questions":{"o":["Dove","Chi","Quando","Come","Perché","Quanto"],"s":[["Perché piangi?","Kodėl verki?","","Perché"],["Chi cerca trova.","Tas kuris ieško, randa.","","Chi"],["Come sei bella!","Kokia tu graži!","","Come"],["Dove sei stato?","Kur tu buvai?","","Dove"],["Quanto è lento!","Koks tu lėtas!","","Quanto"],["Quando bevi caffè?","Kada tu geri kavą?","","Quando"],["Perché è venuta qui?","Kodėl čia atėjai?","","Perché"],["Chi sono quei tipi?","Ka