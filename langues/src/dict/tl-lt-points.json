{"v":1,"p":{"ordre":{"o":["ang","ng","sa","si","ni","kay"],"s":[["Itim ang pusa.","Katė yra juoda.","","ang"],["Pumili ng isa.","Pasirink vieną.","","ng"],["Salamat sa Diyos.","Ačiū Dievui.","","sa"],["Nawala si Tom.","Tomas pradingo.","","si"],["Gusto ni Tom ang keso.","Tomui patinka sūris.","","ni"],["Kinikilabutan ako kay Tom.","Tomas mane baugina.","","kay"],["Mabaho ang tae.","Šūdas smirda.","","ang"],["Pahingi ng tsaa.","Prašau arbatos.","","ng"],["Manatili sa bahay.","Lik namie.","","sa"],["Tumawa si Tom.","Tomas sukrizeno.","","si"]]},"pronoms":{"o":["ako","ikaw","siya","kami","tayo","sila"],"s":[["Nagkamali ako.","Aš padariau klaidą.","","ako"],["Dumating siya.","Jis atėjo.","","siya"],["Handa na tayo.","Mes pasirengę.","","tayo"],["Handa na kami.","Mes pasirengę.","","kami"],["Nagpalitan sila ng mga regalo.","Jie apsikeitė dovanomis.","","sila"],["Hindi ba ikaw Tom?","Ar tu ne Tomas?","","ikaw"],["Sang-ayon ako.","Aš sutinku.","","ako"],["Nabuntis siya.","Ji tapo nėsčia.","","siya"],["Nagmamahalan tayo.","Mes mylime vienas kitą.","","tayo"],["Nagmamahalan kami.","Mes mylime vienas kitą.","","kami"]]},"demonstratifs":{"o":["ito","iyan","iyon","dito","diyan","doon"],"s":[["Sisiw lang ito.","Tai vieni juokai.","","ito"],["Alam mo ba iyon?","Ar tu tai žinojai?","","iyon"],["Sisiw lang iyan.","Tai vieni juokai.","","iyan"],["Uupo ka lamang dito.","Tau tik reikia čia sedėti.","","dito"],["Kompyuter ko ito.","Tai mano kompiuteris.","","ito"],["Sisiw lang iyon.","Tai vieni juokai.","","iyon"],["Totoo iyan, di ba?","Tai tiesa, ar ne?","","iyan"],["Puwede kang mag-aral dito.","Gali čia mokytis.","","dito"],["Kailangan mo ito.","Tau šito reikia.","","ito"],["Totoo iyon, di ba?","Tai tiesa, ar ne?","","iyon"]]},"negation-questions":{"o":["Ano","Sino","Saan","Kailan","Paano","Bakit"],"s":[["Ano ang habol niya?","Ko jis siekia?","","Ano"],["Bakit ka umiiyak?","Kodėl verki?","","Bakit"],["Saan ka pupunta?","Kur eini?","","Saan"],["Paano mo nakilala siya?","Kaip tu su juo