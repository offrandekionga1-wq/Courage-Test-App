 at ipapakita ko sa iyo kung sino ako.","Ateik ir aš tau parodysiu kas aš esu.","","at"],["Halika at ipapakita ko sa inyo kung sino ako.","Ateik ir aš tau parodysiu kas aš esu.","","at"]]},"focus":{"o":["ginawa","binili","nakita"],"s":[["Ano ang ginawa mo nitong tag-init?","Ką veikei šią vasarą?","","ginawa"],["May binili akong kuting.","Aš nusipirkau kačiuką.","","binili"],["Saan mo nakita ang mga babaeng iyon?","Kur tu matei tas moteris?","","nakita"],["Ano ang ginawa mo nitong tag-araw?","Ką veikei šią vasarą?","","ginawa"],["May binili po akong kuting.","Aš nusipirkau kačiuką.","","binili"],["May nakita akong isang magandang ibon.","Aš mačiau nuostabų paukštį.","","nakita"],["Magsarili mo bang ginawa ang homework mo?","Ar padarei savo namų darbus pats?","","ginawa"]]},"magalang":{"o":["po","opo","ba","na"],"s":[["Madilim na po.","Jau tamsu.","","po"],["Koreano po ako.","Aš korėjietis.","","po"],["Kumusta po kayo?","Kaip gyveni?","","po"],["Busog na po ako.","Esu soti.","","po"],["Mahal ko po kayo.","Aš tave myliu.","","po"],["Nabuntis po siya.","Ji tapo nėsčia.","","po"],["Mahal ko po siya.","Aš ją myliu.","","po"],["Sisiw lang po ito.","Tai vieni juokai.","","po"],["Isa po itong sumpa.","Tai prakeikimas.","","po"],["Magandang umaga po.","Labas rytas.","","po"]]},"lieu":{"o":["nasa","nasaan","saan","sa"],"s":[["Ang libro ay nasa mesa.","Knyga guli ant stalo.","","nasa"],["Manatili kung nasaan ka.","Lik kur esi.","","nasaan"],["Sino ka at saan ka galing?","Kas tu ir iš kur esi?","","saan"],["Sinasabi mo bang nasa peligro ang buhay ko?","Ar tu sakai kad mano gyvybė yra pavojuje?","","nasa"],["Sinasabi mo bang nasa panganib ang buhay ko?","Ar tu sakai kad mano gyvybė yra pavojuje?","","nasa"],["Ang pusa ba'y nasa ibabaw ng silya o sa ilalim ng silya?","Katė ant kėdės ar po kėde?","","nasa"]]},"bilang":{"o":["isang","dalawang","isa","dalawa","anim","sampu"],"s":[["Si Tom ay isang bampira.","Tomas yra vampyras.","","isang"],["May dalawang kotse siya.","Jis turi du automobilius.","","dalawang"],["Pumili ng isa.","Pasirink vieną.","","isa"],["Natutulog siya na dalawa ang unan.","Ji miega su dvejomis pagalvėmis.","","dalawa"],["Natuto akong magbisikleta noong anim na taong gulang ako.","Aš išmokau važiuoti dviračiu kai man buvo šešeri.","","anim"],["Ako ay bumibilang hanggang sampu.","Aš skaičiuoju iki dešimties.","","sampu"],["Pabalik ako sa isang oras.","Grįšiu po valandos.","","isang"],["Mayroon akong dalawang pusa.","Aš turiu dvi kates.","","dalawang"],["Mahal natin ang isa't-isa.","Mes mylime vienas kitą.","","isa"],["May dalawa akong pinag-aaralang wikang banyaga.","Aš mokausi du užsienio kalbas.","","dalawa"]]},"pang-uri":{"o":["mas","kaysa","pinakamataas","pinakamahalagang","pinakamagandang","pinakamagaling","pinakaimportanteng","pinakaimportante"],"s":[["Sana mas matangkad ako nang kaunti.","Norėčiau būti truputį aukštesnis.","","mas"],["Mas maganda ako kaysa sa iyo.","Aš gražesnė nei tu.","","kaysa"],["Ito ang pinakamataas na tore sa bansang Hapon.","Tai yra aukščiausias bokštas Japonijoje.","","pinakamataas"],["Ikaw ang pinakamahalagang tao sa buhay ko.","Tu esi pats svarbiausias asmuo mano gyvenime.","","pinakamahalagang"],["Saan ba ang pinakamagandang lugar sa mundo?","Kur yra gražiausia vieta pasaulyje?","","pinakamagandang"],["Iyon ang pinakamagaling na araw sa buhay ko.","Tai buvo geriausia mano gyvenimo diena.","","pinakamagaling"],["Ikaw ang pinakaimportanteng tao sa buhay ko.","Tu esi pats svarbiausias asmuo mano gyvenime.","","pinakaimportanteng"],["Ang pinakaimportante sa buhay ay maging basta sarili.","Pats svarbiausias dalykas gyvenime yra būti savimi.","","pinakaimportante"],["Humingi siya ng mas maayos na sahod.","Jis reikalavo didesnio atlyginimo.","","mas"],["Mas maganda ako kaysa sa inyo.","Aš gražesnė nei tu.","","kaysa"]]},"pag-aari":{"o":["may","kanya","iyo","akin","wala"],"s":[["Lahat may gusto sa kaniya.","Ją visi mėgsta.","","may"],["Umiibig ako sa kanya.","Aš ją myliu.","","kanya"],["Anong nakagising sa iyo?","Kas tave pažadino?","","iyo"],["Magtiwala sa akin.","Pasitikėk manimi.","","akin"],["Bakit ba wala akong boypren?","Kodėl aš neturiu vaikino?","","wala"],["Ako'y may maraming kaibigan.","Aš turiu daug draugų.","","may"],["Umiibig po ako sa kanya.","Aš ją myliu.","","kanya"],["Mas maganda ako kaysa sa iyo.","Aš gražesnė nei tu.","","iyo"],["Di akin ang mga ito.","Šie daiktai nėra mano!","","akin"],["Hindi ako mabubuhay kung wala ka.","Aš negaliu be tavęs gyventi.","","wala"]]},"gusto":{"o":["gusto","ayaw","kailangan","puwede","dapat"],"s":[["Anong gusto mong sabihin?","Ką tu nori pasakyti?","","gusto"],["Anong dapat kong dalhin?","Ką turėčiau atnešti?","","dapat"],["Mukhang kailangan ng pusa ang tubig.","Katė atrodo lyg ji nori vandens.","","kailangan"],["Ayaw na ayaw ko ang mga sinungaling.","Aš nekenčiu melagių.","","ayaw"],["Hindi ako puwede.","Aš negaliu.","","puwede"],["Lahat may gusto sa kaniya.","Ją visi mėgsta.","","gusto"],["Hindi ka dapat mag-antay dito.","Neturėtum čia laukti.","","dapat"],["Lahat ng halaman ay kailangan ang tubig at ilaw.","Visiems augalams reikia vandens ir šviesos.","","kailangan"],["Kung ayaw mong pumaroon, di hindi tayo paparoon.","Jeigu tu nenori ten eiti, tada mes ten neisime.","","ayaw"],["Ano ang gusto mong kainin?","Ko nori valgyti?","","gusto"]]},"maka":{"o":["nakita"],"s":[["Saan mo nakita ang mga babaeng iyon?","Kur tu matei tas moteris?","","nakita"],["May nakita akong isang magandang ibon.","Aš mačiau nuostabų paukštį.","","nakita"]]}}}